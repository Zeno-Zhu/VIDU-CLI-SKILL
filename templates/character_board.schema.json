{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "角色设定板数据",
  "description": "填这份 JSON，由 board_build.py 渲染 A/B 两版固定骨架；结构由脚本锁死，内容与风格段自由。",
  "type": "object",
  "required": ["variant", "style", "core"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^CH[0-9]{2}$"},
    "variant": {"type": "string", "enum": ["A", "B"]},
    "style": {"type": "string", "minLength": 2, "maxLength": 24},
    "core": {
      "type": "object",
      "required": ["name", "alias", "age", "height", "weight", "occupation", "positioning"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4},
        "alias": {"type": "string", "minLength": 1},
        "age": {"type": "string", "pattern": "^[0-9]{1,3}岁$"},
        "height": {"type": "string", "pattern": "^[0-9]{2,3}cm$"},
        "weight": {"type": "string", "pattern": "^[0-9]{2,3}kg$"},
        "occupation": {"type": "string", "minLength": 4},
        "positioning": {"type": "string", "minLength": 4}
      }
    },
    "optional": {
      "type": "object",
      "properties": {
        "personality": {
          "type": "object",
          "required": ["keywords", "habits"],
          "properties": {
            "keywords": {"type": "string", "minLength": 2},
            "habits": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 2}}
          }
        },
        "voice": {
          "type": "object",
          "description": "仅 A 版允许；B 版整段不得出现。",
          "required": ["range", "hz", "breath", "speed", "tone", "sibilance"],
          "properties": {
            "range": {"type": "string", "minLength": 2},
            "hz": {"type": "string", "pattern": "^[0-9]{2,3}—[0-9]{2,3} ?Hz$"},
            "breath": {"type": "string", "minLength": 2},
            "speed": {"type": "string", "minLength": 2},
            "tone": {"type": "string", "minLength": 2},
            "sibilance": {"type": "string", "minLength": 2}
          }
        },
        "outfits": {
          "type": "object",
          "required": ["note", "items"],
          "properties": {
            "note": {"type": "string", "minLength": 2},
            "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 2}}
          }
        },
        "props": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 2}}
          }
        }
      },
      "additionalProperties": false
    },
    "style_note": {"type": "string", "minLength": 8}
  },
  "allOf": [
    {
      "if": {"properties": {"variant": {"const": "A"}}},
      "then": {"required": ["optional"], "properties": {"optional": {"required": ["voice"]}}}
    },
    {
      "if": {"properties": {"variant": {"const": "B"}}},
      "then": {"properties": {"optional": {"not": {"required": ["voice"]}}}}
    }
  ],
  "x-rules": [
    "A 版 optional.voice 六项必须全填；B 版不得出现 voice。",
    "personality.habits 恰好 5 条；outfits.items 恰好 3 套；props.items 1-2 件。",
    "可选模块只能完整存在或整段不存在，不许留空。",
    "style_note 缺省时用：整体为棚拍写实质感、真实皮肤纹理、自然布料褶皱、柔和均匀光影，同一角色五官、发型、体型全程统一，无崩坏、无卡通化、无文字乱码。",
    "A 版 voice.hz 必须与 音色-<name>.txt 第 2 维逐字一致。"
  ]
}
